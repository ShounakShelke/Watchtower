# ==========================================
# Watchtower V2 — Environment Configuration
# ==========================================

# Database
DATABASE_URL="postgresql://postgres:bankai@localhost:5432/watchtower"

# Authentication & Session Security (Min 32 random characters for SESSION_SECRET)
AUTH_EMAIL="you@example.com"
AUTH_PASSWORD="set-a-long-unique-password-for-single-user-login"
AUTH_SECRET="replace-with-a-long-random-value"
SESSION_SECRET="replace-with-a-second-long-random-secret-min-32-chars"

# Primary & Fallback AI Providers
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar OAuth Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# Optional Embeddings for Semantic Retrieval (defaults to GEMINI_API_KEY if left empty)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_API_KEY=""

# Scheduled Background Automation Protection
CRON_SECRET=""

# Optional Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"
